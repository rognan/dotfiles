# ~/.bash_prompt

if infocmp xterm-256color >/dev/null 2>&1; then
    export TERM=xterm-256color
fi

if tput setaf 1 &> /dev/null; then
    if [[ $(tput colors) -ge 256 ]] 2>/dev/null; then
        MAGENTA="\[$(tput setaf 9)\]"
        ORANGE="\[$(tput setaf 172)\]"
        GREEN="\[$(tput setaf 190)\]"
        PURPLE="\[$(tput setaf 141)\]"
        WHITE="\[$(tput setaf 255)\]"
    else
        MAGENTA="\[$(tput setaf 5)\]"
        ORANGE="\[$(tput setaf 4)\]"
        GREEN="\[$(tput setaf 2)\]"
        PURPLE="\[$(tput setaf 1)\]"
        WHITE="\[$(tput setaf 7)\]"
    fi
    BOLD="\[$(tput bold)\]"
    RESET="\[$(tput sgr0)\]"
else
    MAGENTA="\[\033[1;35m\]"
    ORANGE="\[\033[1;33m\]"
    GREEN="\[\033[1;32m\]"
    PURPLE="\[\033[1;35m\]"
    WHITE="\[\033[1;37m\]"
    BOLD=""
    RESET="\[\033[m\]"
fi

tab_title() {
  parent=$(basename "$(dirname "$PWD")")
  echo -n "$parent/$(basename "$PWD")"
}

GIT_PS1_SHOWDIRTYSTATE=true

PS1="\[\e]2;\u@\h:\w\a\]\[\e]1;\$(tab_title)\a\]${BOLD}${GREEN}\w ${PURPLE}\$(__git_ps1 \"%s\")${WHITE}\n\$ $RESET"
